# Copy to .env and fill in the secrets:  make env
#
# Nothing here may contain an absolute path. The project directory name contains a
# space, and interpolating it into compose or shell commands is the one thing that
# reliably breaks on this machine. Volumes in docker-compose.yml are all relative.

# --- compose ---
# Pinned explicitly. Without it, Compose derives the project name from the directory
# name ("wikiflow" is fine, but the parent "data engineer" makes derived names
# inconsistent across tools). Pinning removes the ambiguity entirely.
COMPOSE_PROJECT_NAME=wikiflow

# --- images (pin these; see `make pin-images`) ---
AIRFLOW_IMAGE=wikiflow/airflow:3.3.1-python3.12
POSTGRES_IMAGE=postgres:16
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# --- airflow ---
# 50000 is what the official image expects; on Docker Desktop for Windows this is
# the documented value (Linux users should use `id -u`).
AIRFLOW_UID=50000
FERNET_KEY=generate-me
AIRFLOW__API_AUTH__JWT_SECRET=generate-me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- minio ---
MINIO_ROOT_USER=wikiflow
MINIO_ROOT_PASSWORD=wikiflow_dev_secret
WIKIFLOW_RAW_BUCKET=wikiflow-raw
WIKIFLOW_LAKE_BUCKET=wikiflow-lake

# --- server warehouse (ADR 0008) ---
WIKIFLOW_PG_USER=wikiflow
WIKIFLOW_PG_PASSWORD=wikiflow_dev_secret
WIKIFLOW_PG_DATABASE=wikiflow

# --- wikiflow ---
# Wikimedia asks automated clients to identify themselves. Be honest here.
WIKIFLOW_USER_AGENT=wikiflow/0.1 (portfolio project; https://github.com/loadbearingcode-222/wikiflow)
